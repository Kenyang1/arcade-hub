# Copy to .env (PowerShell: Copy-Item .env.example .env). Never commit .env.
# Fake values only in this file.

# API (Express; `pnpm --dir api dev` loads this file)
NODE_ENV=development
PORT=5080
MONGO_URL=mongodb://localhost:27018
MONGO_DB=arcadehub
JWT_SIGNING_KEY=replace-with-a-long-random-string-at-least-32-chars
JWT_ISSUER=arcade-hub
SEED_DEV_USERS=true
SEED_DEV_PASSWORD=dev-password-123

# Web (Vite only exposes variables that start with VITE_)
VITE_API_BASE_URL=/api
