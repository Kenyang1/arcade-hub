# Copy to .env (PowerShell: Copy-Item .env.example .env). Never commit .env.
# Fake values only in this file.

# API (ASP.NET Core reads these as configuration; double underscore = section)
ASPNETCORE_ENVIRONMENT=Development
Mongo__ConnectionString=mongodb://localhost:27018
Mongo__Database=arcadehub
Jwt__SigningKey=replace-with-a-long-random-string-at-least-32-chars
Jwt__Issuer=arcade-hub
Seed__DevUsers=true
Seed__DevPassword=dev-password-123

# Web (Vite only exposes variables that start with VITE_)
VITE_API_BASE_URL=/api
